# Contributor: Wilhem Barbier <wilhem.b@free.fr>
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

pkgname=raylib-jpg
_pkgname=raylib
pkgver=6.2
pkgrel=2
pkgdesc='Simple and easy-to-use game programming library, with JPG file format support enabled, built as a static library'
arch=('x86_64' 'aarch64')
url='https://www.raylib.com'
license=(Zlib)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('staticlibs')
makedepends=(cmake libx11 libxcursor libxinerama libxrandr libxi vulkan-headers xorg-server-devel xorg-xinput)
source=("$_pkgname-$pkgver.tar.gz::https://github.com/raysan5/raylib/archive/refs/tags/$pkgver.tar.gz"
        raylib-enable-jpg.patch)
sha256sums=('df7a13129b1bec9e73a6962efff170beba310ee6eab8f94cd000b7316b4db5ee'
            '622d5f2edcab6f3bfba5445de738db92232ccb0dcc7132077d560ad2a4c324b6')

prepare() {
  cd "$_pkgname-$pkgver"
  patch -p1 -i "$srcdir/raylib-enable-jpg.patch"
}

build() {
  cmake \
    -B build \
    -D BUILD_EXAMPLES=OFF \
    -D BUILD_SHARED_LIBS=OFF \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_C_FLAGS="$CFLAGS -fPIC -w" \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D OpenGL_GL_PREFERENCE=GLVND \
    -D PLATFORM=Desktop \
    -D USE_EXTERNAL_GLFW=OFF \
    -D WITH_PIC=ON \
    -S "$_pkgname-$pkgver" \
    -W no-dev
  make -C build
}

package() {
  DESTDIR="$pkgdir" make -C build install
  # static-only build: raylib.pc ships an empty Libs.private, so append the
  # static link dependencies to Libs; plain `pkg-config --libs raylib` then
  # links correctly without --static
  sed -i 's/^Libs: .*/& -lGL -lX11 -lXext -lm -lpthread -ldl -lrt/' \
    "$pkgdir/usr/lib/pkgconfig/raylib.pc"
  for f in rcamera rgestures; do
    install -Dm644 "$_pkgname-$pkgver/src/$f.h" "$pkgdir/usr/include/$f.h"
  done
  install -Dm644 "$_pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

