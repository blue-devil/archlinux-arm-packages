From d5f534fea727b7b10b13beffef5b614ce0960d02 Mon Sep 17 00:00:00 2001
From: Antonio Rojas <arojas@archlinux.org>
Date: Tue, 29 Sep 2026 20:47:25 +0200
Subject: [PATCH 2/5] Use \c instead of ?* to list commands, which no longer
 works in 2.19

---
 src/sage/interfaces/gp.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/sage/interfaces/gp.py b/src/sage/interfaces/gp.py
index e9d005c73dd..3ec71eb7319 100644
--- a/src/sage/interfaces/gp.py
+++ b/src/sage/interfaces/gp.py
@@ -367,7 +367,7 @@ def _tab_completion(self):
         try:
             b = self.__builtin
         except AttributeError:
-            b = self.eval('?*').split()
+            b = self.eval('\\c').split()
             self.__builtin = b
         return b + self.eval('?0').split()
 

