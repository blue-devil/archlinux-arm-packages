pkgname=radare2
pkgver=6.2.4
pkgrel=1
pkgdesc='Open-source tools to disasm, debug, analyze and manipulate binary files'
arch=('x86_64' 'aarch64')
url='https://radare.org'
license=('GPL-3.0-only AND LGPL-3.0-only')
depends=(
  capstone
  file
  glibc
  libgcc
  libuv
  libzip
  lz4
  sh
  xxhash
  zlib
  zydis
)
makedepends=(
  git
  meson
)
optdepends=('r2ghidra: ghidra decompiler plugin')
options=('!emptydirs')
_sdb_ver=2.5.8
_qjs_ver=b51e5278439b2fa0510fbb1f3b3dff9f0064d5d7
# The testbins commit is not locked upstream but do it here for
# reproducibility.
_testbins_ver=297b778000bbfaf9bf4717cb95535c3b80d52e3e
source=(
  "git+https://github.com/radareorg/radare2.git#tag=$pkgver"
  "git+https://github.com/radareorg/sdb.git#tag=$_sdb_ver"
  "qjs::git+https://github.com/quickjs-ng/quickjs.git#commit=$_qjs_ver"
  "git+https://github.com/radareorg/radare2-testbins.git#commit=$_testbins_ver"
)
b2sums=('cdef204a17b0c7ffdd601c4792d0fe1433282281259f8076872eff8f1fa03d6dd69c29a2ac2f636719d3456ff23d1f51e58aa32dd12c78f6119e71dccb277ebf'
        'c57a79c88bda8a191bca07251e3cd4b3275cf0d7915ec5f5fe05b8e60207539c186572a45a98c290a1e1b521b508c74f1471e2821aa679663357b783e05646bf'
        'a63a54821b7b38d57a6489c103482a5d16abc60f50643d31c4cd00398617e4aae651fad0ac3d93546d2f74219e2925d28f694e914f7fb144d25b54c2efdc2604'
        'daf9ac38c86cbd441fdfe65540f107579b813766ef89dfae53a1038cf79070eb9e744f9b458da63700b8872c7fb6159c94d78be5c7b180c52b390668dd955c00')

prepare() {
  cd $pkgname
  for subproject in sdb qjs; do
    local ver_var=_${subproject//-/_}_ver
    local expected_ver=${!ver_var}
    grep -q "revision = $expected_ver" subprojects/$subproject.wrap \
      || { echo "Version mismatch in subproject $subproject"; exit 1; }
  done

  cp -a ../radare2-testbins test/bins

  # The meson build of this tag neither builds the pcap bin plugin nor
  # registers the tmp fs plugin, although the unit test suite exercises
  # both. Upstream only builds them in the legacy make system (the fs
  # plugin list was fixed in master after this tag, pcap is still not
  # ported to meson). Wire both into the meson build so the full test
  # suite can run.
  sed -i "s/^fs_plugins = \[ 'r2', /fs_plugins = [ 'tmp', 'r2', /" libr/meson.build
  sed -i "s/^bin_plugins = \[ 'null' \]/bin_plugins = [ 'pcap', 'null' ]/" libr/meson.build
  sed -i "s|^  'p/bin_art\.c',$|  'p/bin_art.c',\n  'p/bin_pcap.c',\n  'format/pcap/pcap.c',|" libr/bin/meson.build
}

build() {
  cd $pkgname
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  arch-meson build \
    -D use_sys_capstone=true \
    -D use_capstone_version=v5 \
    -D use_sys_magic=true \
    -D use_sys_zip=true \
    -D use_sys_zlib=true \
    -D use_sys_lz4=true \
    -D use_sys_xxhash=true \
    -D use_sys_zydis=true \
    -D use_libuv=true \
    -D use_webui=true
  meson compile -C build
}

check() {
  cd $pkgname
  export PATH="$PWD/build/binr/radare2:$PATH"

  # Unit tests need radare2's calling-convention database. The meson build never
  # defines HAVE_GPERF, so it isn't compiled in and is only loaded from an
  # installed prefix or from XDG_DATA_HOME. Without it x86-64 functions get the
  # default "reg" callconv instead of "amd64", which disables variadic detection
  # in libr/anal/fcn.c and fails test_anal_function.
  export XDG_DATA_HOME="$srcdir/xdg-data"
  install -vDm644 -t "$XDG_DATA_HOME/radare2/fcnsign" build/libr/anal/d/cc-*.sdb

  meson test -C build --print-errorlogs

  #meson test -C build
}

package() {
  depends+=(
    libcapstone.so
    libmagic.so
    libzip.so
  )

  cd $pkgname
  meson install -C build --destdir "$pkgdir"
  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  cp -va doc/* "$pkgdir/usr/share/doc/$pkgname"
  ln -vs /usr/share/man/man1/radare2.1.gz "$pkgdir/usr/share/man/man1/r2.1.gz"
}

