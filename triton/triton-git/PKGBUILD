_pkgname=triton
pkgname=${_pkgname}-git
pkgver=0.9.r778.gbc84cf74
pkgrel=1
pkgdesc='Dynamic binary analysis framework'
url='https://triton.quarkslab.com/'
arch=('x86_64' 'aarch64')
license=('Apache')
depends=('capstone' 'z3' 'python')
makedepends=('git' 'boost' 'cmake')
provides=(${_pkgname})
conflicts=(${_pkgname})
source=("$pkgname::git+https://github.com/JonathanSalwan/Triton.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  git describe --tags --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd $pkgname

  # BUILD_EXAMPLES (default ON) pulls in src/examples/cpp, which optionally
  # builds a "hooking_libc" example against LIEF if find_package(LIEF)
  # succeeds. The aarch64 `lief` package (0.15.1-1) ships a broken CMake
  # export (LIEFExport-shared.cmake) that references the "tl::expected"
  # imported target without ever creating/finding it via
  # find_dependency(tl-expected), so configure fails with:
  #   "The link interface of target LIEF::LIEF contains: tl::expected
  #    but the target was not found."
  # This is a bug in the system lief/tl-expected packaging, not in Triton.
  # None of the example binaries are installed by `package()` anyway, so
  # just disable BUILD_EXAMPLES to skip that broken optional dependency
  # entirely.
  cmake ./ -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_EXAMPLES=OFF
  cmake --build .
}

package() {
  cd $pkgname
  DESTDIR="$pkgdir" cmake --install .
}

