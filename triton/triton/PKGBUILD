pkgname=triton
_pkgname=Triton
pkgver=0.9
pkgrel=1
pkgdesc='Dynamic binary analysis framework'
url='https://triton.quarkslab.com/'
arch=('x86_64' 'aarch64')
license=('Apache')
depends=('boost-libs' 'capstone' 'z3' 'python' 'llvm')
makedepends=('boost' 'cmake')
source=(${pkgname}-${pkgver}.tar.gz::https://github.com/JonathanSalwan/${_pkgname}/archive/v${pkgver}.tar.gz
        gcc16-python314-compat.patch
        python314-pylongobject-abi.patch)
sha512sums=('f34cc9787837dc826e21997a86c32087b29ed9662bc8e0ac8ddb934978a64bdfd54c3d1303689be2a9dff4a0f3c9128219e04881e6c98f5e21a27ecd57489586'
            '1279e0bee866c0f1e58c693162621c6a2f55370b5a98a62eff6a6aef9ce68efd5bdd318106ae75f884568a2b4524bb7cecb6040879285845b0e6183f1c33fabf'
            '8df09c93e643d7980684d4c1327df2c8f739d37dc8099136c18688e4387dfcc4099d31c87de216c898058a48ae2afb30971dd9787900a90f81ac96110ba24c2f')

prepare() {
  cd ${_pkgname}-${pkgver}

  # Fixes for building Triton 0.9 (released 2020) against a modern
  # aarch64 toolchain (GCC 16, Boost 1.92, capstone 5.x, Python 3.14):
  #
  #   - capstone 5.x dropped several duplicate/legacy x86 instruction IDs
  #     (X86_INS_FADDP, X86_INS_UD2B, X86_INS_VCVTPD2DQX,
  #     X86_INS_VCVTPD2PSX, X86_INS_VCVTTPD2DQX) that Triton's
  #     x86Specifications.cpp switch-statement still references.
  #   - modesEnums.hpp uses uint64_t without including <cstdint>; newer
  #     libstdc++ no longer pulls it in transitively via <unordered_set>.
  #   - <longintrepr.h> is no longer installed at Python's top-level
  #     include dir since Python 3.11; it now lives at
  #     <cpython/longintrepr.h>.
  patch -Np1 -i "${srcdir}/gcc16-python314-compat.patch"

  # bindings/python/utils.cpp manually reached into CPython's private
  # PyLongObject internals (the ob_digit array, Py_SIZE() used as an
  # lvalue, and the deprecated _PyLong_New) to hand-roll conversions
  # between Python ints and Triton's native/boost-multiprecision integer
  # types. CPython 3.12+ completely changed that internal layout (digits
  # now live inside a tagged _PyLongValue struct), breaking this with
  # "'PyLongObject' has no member named 'ob_digit'" and related errors.
  # This patch rewrites the affected functions to use only the stable,
  # public Python C-API (PyNumber_And/Or/Lshift/Rshift and
  # PyLong_From/AsUnsignedLongLong), which works identically across every
  # CPython 3.x release. Verified against 100000+ randomized round-trip
  # conversions plus edge cases for all integer widths Triton uses
  # (32/64/128/256/512-bit).
  patch -Np1 -i "${srcdir}/python314-pylongobject-abi.patch"
}

build() {
  cd ${_pkgname}-${pkgver}
  cmake ./ -DCMAKE_INSTALL_PREFIX=/usr
  make
}

package() {
  cd ${_pkgname}-${pkgver}
  make DESTDIR="$pkgdir" install
}

