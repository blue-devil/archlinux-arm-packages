+      //! RAII helper to manage PyObject* references acquired during the
+      //! conversion routines below.
+      class PyRef {
+        public:
+          explicit PyRef(PyObject* obj) : obj(obj) {}
+          ~PyRef() { Py_XDECREF(this->obj); }
+          PyRef(const PyRef&) = delete;
+          PyRef& operator=(const PyRef&) = delete;
+          PyObject* get() const { return this->obj; }
+          operator PyObject*() const { return this->obj; }
+        private:
+          PyObject* obj;
+      };
+
