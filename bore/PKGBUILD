# Maintainer: Blue DeviL // SCT <bluedevil.SCT at proton dot me>

pkgname=bore
pkgver=0.6.0
pkgrel=1
pkgdesc="A simple CLI tool for making tunnels to localhost"
arch=('x86_64' 'aarch64')
url="https://github.com/ekzhang/bore"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('74bb37ac205c30230bd7a0773943f251833787ec52f0be604dd7068ba926d68383c6d5572e3ce2e765088de1a388824c57f05d81ae92579365366339a46a650c')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --frozen
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm 755 "target/release/${pkgname}" -t "${pkgdir}/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim: ts=2 sw=2 et:
