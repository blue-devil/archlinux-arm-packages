+        "tizonia",
+        "youtube-cookies.txt",
+    )
+    if os.path.isfile(_cookiefile):
+        _orig_init = yt_dlp.YoutubeDL.__init__
+
+        def _init(self, params=None, *args, **kwargs):
+            params = dict(params or {})
+            params.setdefault("cookiefile", _cookiefile)
