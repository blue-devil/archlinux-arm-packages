_pkgname="vala-panel"
pkgname="$_pkgname"
pkgver=24.05
pkgrel=4
pkgdesc="Panel for compositing window managers"
url="https://gitlab.com/vala-panel-project/vala-panel"
license=('LGPL-3.0-only')
arch=('x86_64' 'aarch64')

depends=(
  'gtk-layer-shell'
  'gtk3'
  'libwnck3'

  ## implicit
  #at-spi2-core
  #cairo
  #dconf
  #gdk-pixbuf2
  #glib2
  #hicolor-icon-theme
  #pango
)
makedepends=(
  'git'
  'glib2-devel'
  'gobject-introspection'
  'meson'
  'vala'
)
optdepends=(
  'appmenu-glib-translator: sntray'
)

conflicts=(
  'appmenu-glib-translator-git'
  'vala-panel-appmenu-budgie-git'
  'vala-panel-appmenu-common-git'
  'vala-panel-appmenu-jayatana-git'
  'vala-panel-appmenu-mate-git'
  'vala-panel-appmenu-registrar-git'
  'vala-panel-appmenu-valapanel-git'
  'vala-panel-appmenu-xfce-git'
  'vala-panel-git'
)

_pkgsrc="$_pkgname"
source=(
  "$_pkgsrc"::"git+https://gitlab.com/vala-panel-project/vala-panel.git#tag=$pkgver"
  "vala-panel-appmenu"::"git+https://gitlab.com/vala-panel-project/vala-panel-appmenu.git#tag=$pkgver"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

prepare() {
  cp -r vala-panel-appmenu/subprojects "$_pkgsrc/"

  # sntray needs appmenu-glib-translator
  sed -E -e "/importer.*dependency.*appmenu-glib-translator/s&required: false&fallback : ['appmenu-glib-translator', 'importer_dep']&" -i "$_pkgsrc/applets/core/meson.build"

  # GDesktopAppInfo (used by vala_panel_launch/vala_panel_launch_with_context)
  # lives in the GioUnix-2.0 GIR namespace. Without it in the generate_gir()
  # includes, g-ir-scanner cannot resolve the type and marks those functions
  # introspectable="0", so vapigen silently drops ValaPanel.launch() from the
  # generated vala-panel.vapi, breaking the launchbar applet build.
  sed -E -e "s&includes: \['GObject-2.0', 'Gio-2.0', 'Gtk-3.0', 'GModule-2.0'\]&includes: ['GObject-2.0', 'Gio-2.0', 'GioUnix-2.0', 'Gtk-3.0', 'GModule-2.0']&" \
    -i "$_pkgsrc/ui/meson.build"

  # glib2 >= 2.86 split GDesktopAppInfo and friends out of Gio-2.0 into their
  # own GioUnix-2.0 GIR namespace, but vala (<= 0.56.19 at least) still ships
  # a gio-unix-2.0.vapi with no gir_namespace/gir_version CCode attribute, so
  # vapigen cannot map the "GioUnix" GIR namespace back to the gio-unix-2.0
  # vapi package and aborts with "error: The symbol `GioUnix' could not be
  # found" while processing ValaPanel-24.03.gir. Ship a locally patched copy
  # of gio-unix-2.0.vapi (adding gir_namespace = "GioUnix", gir_version =
  # "2.0") in a private vapidir and point generate_vapi() at it via
  # vapi_dirs, without touching the system-wide vala installation.
  local _valaver
  _valaver="$(valac --version | awk '{print $2}' | cut -d. -f1,2)"
  local _valavapidir="/usr/share/vala-${_valaver}/vapi"

  mkdir -p "$srcdir/vapifix"
  cp "$_valavapidir/gio-unix-2.0.vapi" "$srcdir/vapifix/gio-unix-2.0.vapi"
  cp "$_valavapidir/gio-unix-2.0.deps" "$srcdir/vapifix/gio-unix-2.0.deps"
  sed -E -e 's&\[CCode \(cprefix = "G", lower_case_cprefix = "g_"\)\]&[CCode (cprefix = "G", gir_namespace = "GioUnix", gir_version = "2.0", lower_case_cprefix = "g_")]&' \
    -i "$srcdir/vapifix/gio-unix-2.0.vapi"
  sed -E -e "s&packages: \['gio-2.0', 'gtk\+-3.0', 'gio-unix-2.0'\],&packages: ['gio-2.0', 'gtk+-3.0', 'gio-unix-2.0'],\n    vapi_dirs: ['$srcdir/vapifix'],&" \
    -i "$_pkgsrc/ui/meson.build"

  # allow appmenu-glib-translator in separate package
  sed -E -e 's&^(install_headers)&if false\n\1&' \
    -e 's&^(importer_gir)&endif\n\1&' \
    -e 's&install: true&install: false&' \
    -i "$_pkgsrc/subprojects/appmenu-glib-translator/meson.build"
}

build() {
  local _meson_options=(
    -Dwnck=enabled
    -Dplatforms=x11,wayland
  )

  arch-meson build "$_pkgsrc" "${_meson_options[@]}"
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}

