pkgname='opencode-bin'
pkgver=2.2.5
pkgrel=1
pkgdesc='The AI coding agent built for the terminal.'
arch=('aarch64' 'x86_64')
url='https://opencode.ai'
license=('MIT')
provides=('opencode')
conflicts=('opencode' 'opencode2')
depends=('glibc')
options=('!debug' '!strip')

_npmver="${pkgver//_/-}"

source_x86_64=("${pkgname}_${pkgver}_x86_64.tgz::https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-${_npmver}.tgz")
sha256sums_x86_64=('92690eee07a680d3cb760ca02ba43878de9eab1b4e5d5dfae8795518c53628f4')
source_aarch64=("${pkgname}_${pkgver}_aarch64.tgz::https://registry.npmjs.org/@opencode/cli-linux-arm64/-/cli-linux-arm64-${_npmver}.tgz")
sha256sums_aarch64=('f8c5a82075fede9b5b044ed6c8a6d13ad807a7e62caea1cd0a878adef49eb053')

package() {
  install -Dm755 "$srcdir/package/bin/opencode" "$pkgdir/usr/bin/opencode"
}

